generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  type           String
  lat            Float
  lng            Float
  fundsVolume    Float
  rawAddressText String

  // Street address from the SEC submissions API (geocoded later by pipeline.ts).
  businessAddress String?

  // XBRL concept this row measures, e.g. "StockholdersEquity" (part of the id).
  conceptTag String?

  // Tickers from the submissions payload (index membership source).
  tickers String[] @default([])

  // Ingest path that wrote this row: "frames-api" (incremental) or "bulk-zip"
  // (base layer, never pruned by API runs).
  source String @default("frames-api")

  // Provenance (SEC ingestion): which filing validates this row, for which period, as of when.
  secFilingNumber String?
  sourceTimeFrame String?
  financialDate   DateTime?

  // Filing form + date, e.g. "10-Q" filed 2026-07-30.
  form  String?
  filed DateTime?

  // Submissions extras: listing exchanges, filer size, past company names.
  exchanges   String[] @default([])
  category    String?
  formerNames String[] @default([])

  // Merge provenance: [{id, name, source}] rows folded into this one.
  mergedFrom Json?

  sourceFlows CapitalFlow[] @relation("SourceFlows")
  targetFlows CapitalFlow[] @relation("TargetFlows")
}

model CapitalFlow {
  id             String @id @default(cuid())
  sourceEntityId String
  targetEntityId String
  amount         Float
  flowType       String

  // 13F honesty: how many filing sleeves were summed into amount.
  sleeves Int @default(1)

  sourceEntity Entity @relation("SourceFlows", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity @relation("TargetFlows", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId])
  @@index([targetEntityId])
}
