# Copy to backend/.env and fill in real values. Never commit .env.
# Postgres connection for Prisma (Prisma 7 reads this via prisma.config.ts).
# Matches the README's docker command when the password is YOUR_PASSWORD.
# Hosted (e.g. Neon): paste the provider URL verbatim — it carries
# ?sslmode=require, which local Postgres doesn't need.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/whofundsit"

# Backend port (default 4000).
PORT=4000

# Bind address: loopback-only by default. Set to 0.0.0.0 to serve the demo
# to the local network (vite-style `--host`); the startup log prints the LAN
# URL. When unset, the demo asks on a terminal instead.
# HOST="0.0.0.0"

# Declared identity for SEC EDGAR API calls (required by SEC fair-access
# policy): your name plus an email you actually read.
SEC_USER_AGENT="Your Name you@example.com"

# Declared identity for Wikidata SPARQL (required courtesy by Wikimedia).
WIKIDATA_USER_AGENT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Optional free OpenFIGI key (https://www.openfigi.com/): 250 req/min x 100
# CUSIPs instead of 25 x 10 keyless. Only speeds up 13F ticker matching.
OPENFIGI_API_KEY=""

# 13F worker pool size (default scales with CPU: 2x cores, clamped 4-16).
# SEC <=10/s and Nominatim 1/s limits hold regardless — raise for faster
# bulk runs on good hardware.
THIRTEENF_CONCURRENCY=""

# Skip 13F filers whose latest filing is older than 2 years (dead shells).
# Off by default; set to 1 to slim the queue.
THIRTEENF_SKIP_STALE=""

# Declared identity for OpenStreetMap Nominatim (required by usage policy).
NOMINATIM_USER_AGENT="Your Name you@example.com"

# Where geocoding runs: "local" (default, direct Nominatim calls from this
# machine) or "modal" (one batch per run to MODAL_GEOCODE_URL).
GEOCODE_BACKEND="local"

# Modal batch-geocoder webhook (printed by `modal deploy` of geocode_worker.py).
MODAL_GEOCODE_URL=""

# Modal Glimmer-30B address-formalizer OpenAI server (printed by
# `modal deploy` of formalize_worker.py); `npm run formalize:addresses`
# uses it standalone.
MODAL_FORMALIZE_URL=""

# Modal Glimmer-30B verify-flag diagnoser OpenAI server (printed by
# `modal deploy` of inference_worker.py — same @app.server architecture
# as formalize_worker.py, same model); verify:claims ships flags
# undiagnosed when unset. Named INFERENCE after the live app URL.
MODAL_INFERENCE_URL=""

# Optional model override for the diagnose pass (default
# meta-models/Muse-Glimmer-30B, must match the deployed worker).
# MODAL_DIAGNOSE_MODEL=""

# Hugging Face token (read access + Llama 3.1 license accepted): the SOURCE
# value only — push it with `modal secret create huggingface-secret
# HF_TOKEN=...` (or --from-dotenv). Workers run on Modal's infra and read
# Modal's env, never this file. Never --from-dotenv this whole file: it
# would upload DATABASE_URL into the secret too.
HF_TOKEN=""

# Name of the Modal secret holding HF_TOKEN (default huggingface-secret).
# Deploy-time only: `modal deploy` reads your shell env, not this file —
# export MODAL_HF_SECRET_NAME=<name> in the deploying shell when yours differs.
# MODAL_HF_SECRET_NAME=""

# Modal deploy auth (`modal deploy` / CLI): Token ID + Token Secret from
# `modal token new`. Never sent to worker endpoints.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""

# Proxy Auth Token pair for every Modal worker endpoint (geocode/formalize/
# diagnose), sent as Modal-Key / Modal-Secret headers. Create one with
# `modal workspace proxy-tokens create` or at
# modal.com/settings/proxy-auth-tokens (wk-/ws- values, separate from the
# deploy pair above). Required whenever any MODAL_*_URL is set.
MODAL_PROXY_TOKEN_ID=""
MODAL_PROXY_TOKEN_SECRET=""

# OpenAlex funder backing the grant arcs (Hill's grants sit under its parent).
OPENALEX_FUNDER_ID="https://openalex.org/F4320307808"

# Large ingestions: comma-separated funder F-URLs (or bare F... ids).
# Defaults to OPENALEX_FUNDER_ID alone when unset.
# OPENALEX_FUNDER_IDS=""

# Works cap per funder for `npm run flows:openalex` (default 5000).
# OPENALEX_MAX_WORKS=""

# Declared identity for OpenAlex API calls (polite-pool etiquette).
# OPENALEX_USER_AGENT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Optional OpenAlex API key (own $1/day budget; keyless shares a tiny pool).
OPENALEX_API_KEY=""

# Optional contact identity for OpenAlex etiquette.
OPENALEX_CONTACT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Optional funder pin (decimal degrees) when geocoding can't place the funder.
# FUNDER_LAT=""
# FUNDER_LNG=""

# Set to 1 to re-fetch cached API responses (SEC, OpenAlex, Nominatim, Modal).
# Cached payloads live in gitignored backend/data/cache/.
# CACHE_REFRESH=""

# TTL for the in-memory /api/entities + /api/flows response cache
# (tables only change on ingest; one shared JSON string serves all
# visitors, concurrent first loads run one query). Milliseconds.
# RESPONSE_CACHE_TTL_MS="3600000"

# Optional testing cap for `npm run bulk`: stop scanning after this many
# entries (e.g. 200000). Capped runs never touch the address-map cache.
# BULK_MAX_ENTRIES=""

# Set to 1 to re-download the SEC nightly ZIPs even when present.
# BULK_REFRESH=""

# 13F fund managers: BlackRock/Berkshire resolve via the ticker map; Vanguard
# has no ticker so its CIK is pinned (verify live). Override any CIK here.
# THIRTEENF_BLACKROCK_CIK=""
# THIRTEENF_VANGUARD_CIK="102909"
# THIRTEENF_BERKSHIRE_CIK=""

# Full-filer scale-up: discovery scans the local bulk archive (cached).
# Cap managers for testing (0 = all).
# THIRTEENF_MAX_MANAGERS=""

# Demo safety: `npm run db:seed` wipes both tables first, and refuses a
# non-empty database unless this is set (rehearse against a fresh DB).
# DEMO_WIPE_OK=""

# International backbone: `npm run sync:global` pulls GLOBAL_LIMIT
# companies total (default 500, split by per-region quota) and up to
# GLOBAL_MAX_CHILDREN direct children per parent (default 50).
# GLOBAL_LIMIT=""
# GLOBAL_MAX_CHILDREN=""
# Global industry backfill: `npm run industry:global` fills Entity.industry
# on lei: rows from Wikidata P452 (0 = all rows lacking industry).
# INDUSTRY_GLOBAL_LIMIT=""
# Global coords backfill: `npm run coords:global` places unplaced lei: rows
# from Wikidata P625 (0 = all unplaced lei: rows). Run before coords:populate.
# COORDS_GLOBAL_LIMIT=""

# Regional facts ceilings: `npm run regional:esef` (default 500),
# `npm run regional:twse` (default 2000).
# ESEF_LIMIT=""
# TWSE_LIMIT=""

# Declared identity for stock-quote fetches (Yahoo).
# QUOTE_USER_AGENT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Claim-verification sampling for `npm run verify:claims`: fraction of
# rows per cell (default 0.1), cap per cell (default 5), global caps
# (defaults 500 entities / 300 flows), fixed sample size override, and
# an RNG seed override for a different sample (default: fixed seed,
# same sample every run).
# VERIFY_DIAGNOSE=0 skips the diagnose why/how pass; VERIFY_DIAGNOSE_MAX caps
# diagnosed flags per run (default 10).
# VERIFY_FRACTION=""
# VERIFY_MAX_PER_CELL=""
# VERIFY_MAX_ENTITIES=""
# VERIFY_MAX_FLOWS=""
# VERIFY_SAMPLE=""
# VERIFY_SEED=""
# VERIFY_DIAGNOSE=""
# VERIFY_DIAGNOSE_MAX=""

# OpenAlex scale-up: comma-separated funder list (default Colgate parent)
# and per-funder works cap (default 5000, cursor-paged with a key).
# OPENALEX_FUNDER_IDS=""
# OPENALEX_MAX_WORKS=""

# Declared identity for Modal worker calls (formalize/diagnose).
# Not needed
# ~~MODAL_USER_AGENT="WhoFundsIt/0.1 (contact: dev@example.com)"~~
