# Copy to backend/.env and fill in real values. Never commit .env.
# Postgres connection for Prisma (Prisma 7 reads this via prisma.config.ts).
# Matches the README's docker command when the password is YOUR_PASSWORD.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/whofundsit"

# Backend port (default 4000).
PORT=4000

# Declared identity for SEC EDGAR API calls (required by SEC fair-access
# policy): your name plus an email you actually read.
SEC_USER_AGENT="Your Name you@example.com"

# Declared identity for Wikidata SPARQL (required courtesy by Wikimedia).
WIKIDATA_USER_AGENT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Optional free OpenFIGI key (https://www.openfigi.com/): 250 req/min x 100
# CUSIPs instead of 25 x 10 keyless. Only speeds up 13F ticker matching.
OPENFIGI_API_KEY=""

# 13F worker pool size (default 8). SEC <=10/s and Nominatim 1/s limits
# hold regardless — raise for faster bulk runs on good hardware.
THIRTEENF_CONCURRENCY=""

# Declared identity for OpenStreetMap Nominatim (required by usage policy).
NOMINATIM_USER_AGENT="Your Name you@example.com"

# Modal Llama webhook URL (printed by `modal deploy`); pipeline skips AI
# normalization when unset.
MODAL_WEBHOOK_URL=""

# Where geocoding runs: "local" (default, direct Nominatim calls from this
# machine) or "modal" (one batch per run to MODAL_GEOCODE_URL).
GEOCODE_BACKEND="local"

# Modal batch-geocoder webhook (printed by `modal deploy` of geocode_worker.py).
MODAL_GEOCODE_URL=""

# OpenAlex funder backing the grant arcs (Hill's grants sit under its parent).
OPENALEX_FUNDER_ID="https://openalex.org/F4320307808"

# Optional OpenAlex API key (own $1/day budget; keyless shares a tiny pool).
OPENALEX_API_KEY=""

# Optional contact identity for OpenAlex etiquette.
OPENALEX_CONTACT="WhoFundsIt/0.1 (contact: dev@example.com)"

# Optional funder pin (decimal degrees) when geocoding can't place the funder.
# FUNDER_LAT=""
# FUNDER_LNG=""

# Set to 1 to re-fetch cached API responses (SEC, OpenAlex, Nominatim, Modal).
# Cached payloads live in gitignored backend/data/cache/.
# CACHE_REFRESH=""

# Optional testing cap for `npm run bulk`: stop scanning after this many
# entries (e.g. 200000). Capped runs never touch the address-map cache.
# BULK_MAX_ENTRIES=""

# 13F fund managers: BlackRock/Berkshire resolve via the ticker map; Vanguard
# has no ticker so its CIK is pinned (verify live). Override any CIK here.
# THIRTEENF_BLACKROCK_CIK=""
# THIRTEENF_VANGUARD_CIK="102909"
# THIRTEENF_BERKSHIRE_CIK=""

# Full-filer scale-up: discovery scans the local bulk archive (cached).
# Cap managers for testing (0 = all).
# THIRTEENF_MAX_MANAGERS=""
