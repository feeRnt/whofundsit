# Copy to backend/.env and fill in real values. Never commit .env.
# Postgres connection for Prisma (Prisma 7 reads this via prisma.config.ts).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whofundsit"

# Backend port (default 4000).
PORT=4000

# Declared identity for SEC EDGAR API calls (required by SEC fair-access
# policy): your name plus an email you actually read.
SEC_USER_AGENT="Your Name you@example.com"

# Declared identity for OpenStreetMap Nominatim (required by usage policy).
NOMINATIM_USER_AGENT="Your Name you@example.com"

# Modal Llama webhook URL (printed by `modal deploy`); pipeline skips AI
# normalization when unset.
MODAL_WEBHOOK_URL=""

# Where geocoding runs: "local" (default, direct Nominatim calls from this
# machine) or "modal" (one batch per run to MODAL_GEOCODE_URL).
GEOCODE_BACKEND="local"

# Modal batch-geocoder webhook (printed by `modal deploy` of geocode_worker.py).
MODAL_GEOCODE_URL=""
