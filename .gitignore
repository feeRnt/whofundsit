# Secrets — never commit (but do commit the .env.example template)
.env
.env.*
!.env.example

# Dependencies & build output
node_modules/
**/node_modules/
dist/
**/dist/

# Raw downloads & local data (SEC dumps, JSON caches) — all ignored.
# Only the curated demo seed (backend/prisma/seed-data) and the geo seed
# (backend/src/data/*.json) are committed; judges need nothing else.
/data/
backend/data/
downloads/
*.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/tsconfig.*.json

# Python bytecode (Modal worker syntax checks)
*.pyc
__pycache__/

# Curated demo seed (committed intentionally — NOT a raw download).
!backend/prisma/seed-data/*.json
# Geo seed for the demo (geo-mapping.json, committed after geo:snapshot).
!backend/src/data/*.json
