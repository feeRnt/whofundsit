# Secrets — never commit (but do commit the .env.example template)
.env
.env.*
!.env.example

# Dependencies & build output
node_modules/
**/node_modules/
dist/
**/dist/

# Raw downloads & local data (SEC dumps, JSON caches). Rooted so the committed
# ticker snapshots in backend/src/data/ stay tracked.
/data/
backend/data/
downloads/
*.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/tsconfig.*.json

# Python bytecode (Modal worker syntax checks)
*.pyc
__pycache__/
